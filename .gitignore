# ===== 运行后生成的数据（体积大，不入库）=====
# processed/ 168 MB、quarantine 与 checkpoints 也大 —— 且都可由管道重建
data/processed/
data/quarantine/
checkpoints/
*.pth

# 坏图清单是任务一 1-1 的「结果证据」，只有 13 行，特意保留入库。
# 注意：必须先排除目录内容（data/report/*）再反向包含该文件 ——
# 直接写 data/report/ 会把整个目录排除掉，! 反向包含就失效了。
data/report/*
!data/report/bad_files.csv

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# ===== 虚拟环境（本项目复用机器上已有的 venv，不入库）=====
.venv/
venv/
env/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
